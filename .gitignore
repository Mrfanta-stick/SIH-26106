# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# Data files (do not track heavy binaries)
backend/data/*.mmdb
!backend/data/.gitkeep

# Environment variables & local secrets
.env
.env.local

# IDE & OS files
.vscode/
.idea/
.DS_Store

# Next.js / Frontend dependencies
frontend/node_modules/
frontend/.next/
frontend/out/
